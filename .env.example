# Base path the Axios instance prefixes onto requests. Keep as "/api" so the
# Vite dev proxy (below) can forward calls to the backend without CORS.
VITE_API_BASE_URL=/api

# Dev-only. Vite forwards "/api/*" to this backend origin.
# Set this to wherever the Spring Boot backend is listening.
VITE_API_PROXY_TARGET=http://localhost:8081
